# .gitignore

# General Logs
# Logs are machine-specific and should not be versioned.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node Dependencies
# The node_modules folder is generated by `npm install` and can be huge.
# Always regenerate it from package.json and the lockfile.
node_modules/

# Build & Distribution Output
# These folders are generated by the `npm run build` command.
dist/
.out/
build/

# Vite-specific cache
# This directory is used by Vite to cache pre-bundled dependencies.
.vite/

# Environment Variables
# These files contain secrets and machine-specific settings.
# NEVER commit these. Create a .env.example file instead to show what variables are needed.
.env
.env.local
.env.*.local
.env.development
.env.production

# IDE & Editor Configuration
# These are user-specific settings for code editors.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test & Coverage Reports
# Generated when running tests or calculating code coverage.
coverage/
.nyc_output/
junit.xml

# Operating System Generated Files
# General OS files that should not be in a repository.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db
.vscode

# Optional: Dependency Lockfiles
# For a library, you might not commit the lockfile to allow consumers flexibility.
# For an application or reproducible builds (like in this case), it's better to COMMIT the lockfile.
# Uncomment the line below if you choose NOT to commit your lockfile.
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
